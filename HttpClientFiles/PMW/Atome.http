### Query Payment
POST {{url}}/api/{{version}}/QueryPayment/{{payType}}
Content-Type: application/json; charset=UTF-8
X-Secret: {{secretKey}}
X-Key:{{apiKey}}

{  
    "request_id": "{{$guid}}",  
    "country": "HK",
    "transaction_id": "{{tgCode}}"
}
###

@tgCode2 = TG220420A00002
@tgCode3 = TG220420A00003

### Query Payment List
POST {{url}}/api/{{version}}/QueryPaymentList/{{payType}}
Content-Type: application/json; charset=UTF-8
X-Secret: {{secretKey}}
X-Key:{{apiKey}}

{
   "request_id": "{{$guid}}",
   "country": "HK",
   "transactions_info": [
      {
         "payment_id": 1,
         "tg_code": "{{tgCode}}",
         "transaction_id": "{{tgCode}}"
      },
      {
         "payment_id": 2,
         "tg_code": "{{tgCode2}}",
         "transaction_id": "{{tgCode2}}"
      },
      {
         "payment_id": 3,
         "tg_code": "{{tgCode3}}",
         "transaction_id": "{{tgCode3}}"
      }
   ],
   "extend_info": {}
}
###

### Cancel
POST {{url}}/api/{{version}}/Cancel/{{payType}}/{{tgCode}}
Content-Type: application/json; charset=UTF-8
X-Secret: {{secretKey}}
X-Key:{{apiKey}}

{ 
   "request_id" :"{{$guid}}",
   "transaction_id":"{{tgCode}}",
   "extend_info": {}
}
###

@refundRequestId = 1

### Refund
POST {{url}}/api/{{version}}/Refund/{{payType}}/{{tgCode}}
Content-Type: application/json; charset=UTF-8
X-Secret: {{secretKey}}
X-Key:{{apiKey}}

{
    "request_id": "{{$guid}}",
    "transaction_id": "{{tgCode}}",
    "amount": 195,
    "currency": "TWD",
    "extend_info": {
        "refundId": "{{refundRequestId}}"
    }
}
###