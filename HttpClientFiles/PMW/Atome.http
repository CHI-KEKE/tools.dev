### check
GET {{url}}/health
###

### Request Id
GET {{url}}/api/{{version}}/requestId
###

### Pay
POST {{url}}/api/{{version}}/pay/{{payType}}/{{tgCode}}
Content-Type: application/json; charset=UTF-8
X-Secret: {{secretKey}}
X-Key:{{apiKey}}

{
    "request_id": "MGTEST123",
    "country": "MY",
    "currency": "MYR",
    "amount": 349,
    "tg_code": "MGTEST123",
    "device":"Mobile",
    "platform":"iOSApp",
    "extend_info": {
        "mobileNumber": "+600129916207",
        "shippingCountryCode": "MY",
        "shippingAddress": "PT 60303, Jalan KPB 2, Kawasan Perindustrian Kg. Baru Balakong, 43300, Seri Kembangan, Selangor",
        "shippingPostCode": "123",
        "billingCountryCode": "MY",
        "billingAddress": "PT 60303, Jalan KPB 2, Kawasan Perindustrian Kg. Baru Balakong, 43300, Seri Kembangan, Selangor",
        "billingPostCode": "",
        "items": "[{\"itemId\":\"TS01\",\"name\":\"RCBPC Imperial II 28 Inch PP Front Opener Luggage - Expandable+Security zip+TSA - 32890228\",\"quantity\":1,\"price\":349},{\"itemId\":\"TS02\",\"name\":\"Product Title2\",\"quantity\":1,\"price\":25}]",
        "callbackUrl": "https://tw.yahoo.com",
        "paymentResultUrl": "https://www.google.com",
        "shopName": "LilyTest"
    }
}
