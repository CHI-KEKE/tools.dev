script:pre-request {
  const phone = bru.getCollectionVar("phone");
  const outermembercode = bru.getCollectionVar("outermembercode");
  const membercode = bru.getCollectionVar("member_code");
  const shopId = parseInt(bru.getCollectionVar("shop_id"));
  const usingChannelType = bru.getCollectionVar("usingChannelType");
  
  // 修改request-body
  var body = {
      "OuterMemberCode": outermembercode,
      "MemberCode": membercode,
      "CellPhone": phone,
      "UsingChannelType":usingChannelType
  }
  
  var body_data = JSON.stringify(body)
  
  // 取得Timestamp
  await bru.sendRequest({
      url: 'https://api.91mai.com' + '/scm/v1/Utils/GetCurrentTime',
      method: 'POST',
      headers: {
          'content-type': 'application/json',
      }
  }, async function(err, response) {
      const timestamp = response.data
      // console.log("取得Timestamp : " + timestamp)
  //     pm.collectionVariables.set("timestamp", timestamp);
  
      var body =  body_data.toLowerCase();
      // 取得Signature
      var content = "ts=" + bru.getCollectionVar("timestamp") + "&data=" + body + "&sk=" + bru.getCollectionVar("salt_key")
  
      console.log("取得Signature : " + content)
      await bru.sendRequest({
          url: 'https://api.91mai.com' + '/scm/v1/Sample/GetEncryptData',
          method: 'POST',
          headers: {
              "Content-Type": "multipart/form-data",
              },
          data: {
              "key": bru.getCollectionVar("api_key"),
              "content": content
          }
      }, async function(err, response) {
          const signature = response.data.Data
  //         pm.collectionVariables.set("signature", signature);
      });
  });
  
  request_body = body_data
  // console.log("4. 取得request_body:" + request_body)
  // pm.collectionVariables.set("request_body", request_body);
  
  function interpolate (value) {
      const {Property} = require('pm-collection');
  //     return Property.replaceSubstitutions(value, pm.collectionVariables.toObject());
  }
  
}
