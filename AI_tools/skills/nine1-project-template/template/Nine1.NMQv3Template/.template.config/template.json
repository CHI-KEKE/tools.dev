{
  "$schema": "http://json.schemastore.org/template",
  "author": "Arch-Dev3",
  "classifications": [
    "C#",
    "Console",
    "N1Template"
  ],
  "identity": "NMQv3WorkerTemplate",
  "name": "N1.NMQv3WorkerTemplate",
  "shortName": "dotnet.nmqv3.worker",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "INITIAL_DATE": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy/MM/dd"
      },
      "replaces": "{{INITIAL_DATE}}"
    },
    "PREFIX": {
      "type": "parameter",
      "defaultValue": "Nine1"
    },
    "PREFIX_W_LOWER": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "PREFIX",
        "toLower": true
      }
    },
    "ORIGIN_NAME_W_LOWER": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "fileRename": "sample-project",
      "replaces": "sample-project"
    },
    "ORIGIN_NAME_W_UPPER": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "TITLE_TRANS",
      "fileRename": "Sample-Project",
      "replaces": "Sample-Project"
    },
    "FQDN_TRANS_WORDS": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "FQDN_TRANS"
    },
    "SNAKE_TRANS_WORDS": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "SNAKE_TRANS"
    },
    "SNAKE_NAME_W_UPPER": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "SNAKE_TRANS_WORDS",
        "toLower": false
      },
      "fileRename": "SAMPLE_PROJECT",
      "replaces": "SAMPLE_PROJECT"
    },
    "N1_ID": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "PREFIX_W_LOWER"
          },
          {
            "type": "const",
            "value": "-"
          },
          {
            "type": "ref",
            "value": "ORIGIN_NAME_W_LOWER"
          }
        ]
      },
      "fileRename": "nine1-sample-project",
      "replaces": "nine1-sample-project"
    },
    "N1_FQDN_SUFFIX": {
      "type": "derived",
      "valueSource": "FQDN_TRANS_WORDS",
      "valueTransform": "TITLE_TRANS",
      "fileRename": "Sample.Project",
      "replaces": "Sample.Project"
    },
    "N1_FQDN": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "PREFIX"
          },
          {
            "type": "const",
            "value": "."
          },
          {
            "type": "ref",
            "value": "N1_FQDN_SUFFIX"
          }
        ]
      },
      "fileRename": "Nine1.Sample.Project",
      "replaces": "Nine1.Sample.Project"
    },
    "N1_FQDN_W_LOWER": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "N1_FQDN",
        "toLower": true
      },
      "fileRename": "nine1.sample.project",
      "replaces": "nine1.sample.project"
    },
    "N1_FQDN_W_UPPER": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "N1_FQDN",
        "toLower": false
      },
      "fileRename": "NINE1.SAMPLE.PROJECT",
      "replaces": "NINE1.SAMPLE.PROJECT"
    },
    "CAMEL_CASE": {
      "type": "derived",
      "valueSource": "N1_FQDN_SUFFIX",
      "valueTransform": "CAMEL_TRANS",
      "fileRename": "SampleProject",
      "replaces": "SampleProject"
    },
    "N1_CAMEL_CASE": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "const",
            "value": "Nine1"
          },
          {
            "type": "const",
            "value": "."
          },
          {
            "type": "ref",
            "value": "CAMEL_CASE"
          }
        ]
      },
      "fileRename": "Nine1.SampleProject",
      "replaces": "Nine1.SampleProject"
    },
    "databaseSecret": {
        "type": "parameter",
        "datatype": "choice",
        "description": "Use database secret settings?",
        "defaultValue": "none",
        "displayName": "database-secrets",
        "choices": [
            {
                "choice": "none",
                "description": "None (Default)"
            },
            {
                "choice": "postgresql",
                "description": "PostgreSQL"
            },
            {
                "choice": "mssql",
                "description": "MSSQL"
            }
        ]
    },
    "isDatabaseSecretNone": {
        "type": "generated",
        "generator": "regexMatch",
        "datatype": "bool",
        "parameters": {
            "pattern": "^none$",
            "source": "databaseSecret"
        }
    },
    "isDatabaseSecretPostgresql": {
        "type": "generated",
        "generator": "regexMatch",
        "datatype": "bool",
        "parameters": {
            "pattern": "^postgresql$",
            "source": "databaseSecret"
        }
    },
    "isDatabaseSecretMssql": {
        "type": "generated",
        "generator": "regexMatch",
        "datatype": "bool",
        "parameters": {
            "pattern": "^mssql$",
            "source": "databaseSecret"
        }
    }
  },
  "forms": {
    "FQDN_TRANS": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "."
    },
    "SNAKE_TRANS": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "_"
    },
    "CAMEL_TRANS": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": ""
    },
    "TITLE_TRANS": {
      "identifier": "titleCase"
    }
  }
}