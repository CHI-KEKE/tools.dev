<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>
  <packageSources>
    <!-- Ditch all the Global NuGet package sources we only want a 
        single private NuGet repo for this project -->
    <!-- <clear /> -->
    <!-- Add the private NuGet package source for this solution -->
    <!-- <add key="Nine1.AM"
    value="http://entry.build.91app.io:8081/repository/nineyi-release-nuget/" /> -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Nine1.Nuget.Release"
      value="https://entry.build.91app.io/repository/nineyi-release-nuget-hosted/" />
    <add key="Nine1.Nuget.Develop"
      value="https://entry.build.91app.io/repository/nineyi-develop-nuget-hosted/" />
    <add key="Nine1.Nuget.Group"
      value="https://entry.build.91app.io/repository/nineyi-release-nuget/index.json" />
  </packageSources>
</configuration>